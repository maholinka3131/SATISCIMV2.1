<Window x:Class="SatisTakip.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="SATIŞÇIM | Kasa" Height="900" Width="1280"
        MinHeight="720" MinWidth="1000" Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI" WindowStyle="None" ResizeMode="CanResize"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        shell:WindowChrome.WindowChrome="{StaticResource ModernWindowChrome}"
        WindowStartupLocation="CenterScreen" Loaded="MainWindow_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#172B3A" />
        <SolidColorBrush x:Key="Muted" Color="#667085" />
        <SolidColorBrush x:Key="Accent" Color="#0D3B49" />
        <SolidColorBrush x:Key="AccentLight" Color="#EAF3F5" />
        <SolidColorBrush x:Key="Panel" Color="#FFFFFF" />
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.76" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#D8E6E9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="17" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="NavIndicator" Background="Transparent" CornerRadius="2" Margin="0,7" />
                                <Path x:Name="NavIcon" Grid.Column="1" Data="{Binding CommandParameter, RelativeSource={RelativeSource TemplatedParent}}" Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="7,0,0,0" />
                                <ContentPresenter Grid.Column="2" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="NavBorder" Property="Background" Value="#174B59" />
                                <Setter TargetName="NavIndicator" Property="Background" Value="#F59E0B" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Alert">
                                <Setter TargetName="NavIcon" Property="Stroke" Value="#F87171" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#174B59" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#2A7890" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ProductButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#172B3A" />
            <Setter Property="BorderBrush" Value="#E4E7EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ProductCardBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5" Effect="{StaticResource CardShadow}">
                            <Border.RenderTransform>
                                <TranslateTransform />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ProductCardBorder" Property="Background" Value="#FFFBEB" />
                                <Setter TargetName="ProductCardBorder" Property="BorderBrush" Value="#F59E0B" />
                                <Setter TargetName="ProductCardBorder" Property="RenderTransform">
                                    <Setter.Value><TranslateTransform Y="-2" /></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ProductCardBorder" Property="RenderTransform">
                                    <Setter.Value><TranslateTransform Y="0" /></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CartColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#667085" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,11" />
            <Setter Property="BorderBrush" Value="#EAECF0" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style x:Key="CartRow" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="Background" Value="White" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E2F3F7" />
                    <Setter Property="Foreground" Value="#123C4A" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CartCell" TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E2F3F7" />
                    <Setter Property="Foreground" Value="#123C4A" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="{StaticResource BrandDeepBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <Border Width="25" Height="25" CornerRadius="7" Background="{StaticResource AccentAmberBrush}" Margin="0,0,9,0">
                    <TextBlock Text="S" Foreground="{StaticResource BrandDeepBrush}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="SATIŞÇIM" Foreground="White" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Text="  |  SATIŞ NOKTASI" Foreground="#A9C3C9" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource WindowControlButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MinimizeWindowButton_Click" ToolTip="Simge durumuna küçült">
                    <Path Data="{StaticResource MinimizeIcon}" Width="13" Height="13" Stretch="Uniform" Stroke="White" StrokeThickness="1.5" />
                </Button>
                <Button Style="{StaticResource WindowControlButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="ToggleWindowStateButton_Click" ToolTip="Büyüt veya geri yükle">
                    <Path Data="{StaticResource MaximizeIcon}" Width="12" Height="12" Stretch="Uniform" Stroke="White" StrokeThickness="1.4" />
                </Button>
                <Button Style="{StaticResource WindowControlButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseWindowButton_Click" ToolTip="Kapat">
                    <Path Data="{StaticResource CloseIcon}" Width="13" Height="13" Stretch="Uniform" Stroke="White" StrokeThickness="1.6" />
                </Button>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0D3B49" Offset="0" />
                    <GradientStop Color="#104451" Offset="0.58" />
                    <GradientStop Color="#176071" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel Margin="18,22">
                <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="KONTROL PANELİ" Foreground="#9FC0C8" FontSize="10" FontWeight="Bold" Margin="2,6,0,2" />
                    <TextBlock x:Name="VersionText" Foreground="#9FC0C8" FontSize="10" Margin="2,0,0,19" />
                    <TextBlock Text="OPERASYON" Foreground="#80AAB4" FontSize="9" FontWeight="Bold" Margin="3,0,0,4" />
                    <Button Content="Kasa" Tag="Active" CommandParameter="{StaticResource CashIcon}" Style="{StaticResource NavButton}" />
                    <Button x:Name="ProductsNavButton" Content="Ürünler" CommandParameter="{StaticResource ProductsMenuIcon}" Style="{StaticResource NavButton}" Click="ProductsButton_Click" />
                    <Button x:Name="StockEntryNavButton" Content="Stok girişi (barkod)" CommandParameter="{StaticResource StockMenuIcon}" Style="{StaticResource NavButton}" Click="StockEntryButton_Click" />
                    <Button x:Name="StockAlertsNavButton" Content="Kritik stok" CommandParameter="{StaticResource WarningMenuIcon}" Style="{StaticResource NavButton}" Click="StockAlertsButton_Click" />
                    <Button x:Name="StockMovementsNavButton" Content="Stok hareketleri" CommandParameter="{StaticResource MovementMenuIcon}" Style="{StaticResource NavButton}" Click="StockMovementsButton_Click" />
                    <Button x:Name="ImportExcelNavButton" Content="Excel'den Aktar" CommandParameter="{StaticResource ImportMenuIcon}" Style="{StaticResource NavButton}" Click="ImportExcelButton_Click" />
                    <TextBlock Text="FİNANS &amp; CARİ" Foreground="#80AAB4" FontSize="9" FontWeight="Bold" Margin="3,14,0,4" />
                    <Button x:Name="ExpensesNavButton" Content="Gelir-Gider" CommandParameter="{StaticResource LedgerMenuIcon}" Style="{StaticResource NavButton}" Click="AddExpenseButton_Click" />
                    <Button Content="Müşteriler / Veresiye" CommandParameter="{StaticResource PeopleMenuIcon}" Style="{StaticResource NavButton}" Click="CustomersButton_Click" />
                    <Button x:Name="SalesHistoryNavButton" Content="Satış Geçmişi" CommandParameter="{StaticResource ReceiptMenuIcon}" Style="{StaticResource NavButton}" Click="SalesHistoryButton_Click" />
                    <Button x:Name="ReportsNavButton" Content="Satış Raporları" CommandParameter="{StaticResource ChartMenuIcon}" Style="{StaticResource NavButton}" Click="ReportsButton_Click" />
                    <Button x:Name="DayEndNavButton" Content="Gün Sonu Raporu" CommandParameter="{StaticResource CalendarMenuIcon}" Style="{StaticResource NavButton}" Click="DayEndButton_Click" />
                    <TextBlock Text="SİSTEM" Foreground="#80AAB4" FontSize="9" FontWeight="Bold" Margin="3,14,0,4" />
                    <Button x:Name="BackupNavButton" Content="Veritabanı yedekle" CommandParameter="{StaticResource BackupMenuIcon}" Style="{StaticResource NavButton}" Click="BackupButton_Click" />
                    <Button x:Name="RestoreNavButton" Content="Yedekten geri yükle" CommandParameter="{StaticResource RestoreMenuIcon}" Style="{StaticResource NavButton}" Click="RestoreButton_Click" />
                    <Button x:Name="UserManagementNavButton" Content="Kullanıcı yönetimi" CommandParameter="{StaticResource UserIcon}" Style="{StaticResource NavButton}" Click="UserManagementButton_Click" />
                    <Button x:Name="AdminSettingsNavButton" Content="Yönetici Ayarları" CommandParameter="{StaticResource SettingsMenuIcon}" Style="{StaticResource NavButton}" Click="AdminSettingsButton_Click" />
                </StackPanel>
                </ScrollViewer>
                <StackPanel x:Name="FinancialSummaryPanel" DockPanel.Dock="Bottom" Margin="0,14,0,0">
                    <Border Background="#173F4D" BorderBrush="#35616C" BorderThickness="1" CornerRadius="13" Padding="15">
                        <StackPanel>
                            <TextBlock Text="BUGÜN" Foreground="#9AC2CC" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock x:Name="TodaySalesText" Text="0,00 TL" Foreground="White" FontSize="21" FontWeight="Bold" Margin="0,5,0,0" />
                            <TextBlock Text="Satış özeti" Foreground="#9AC2CC" FontSize="11" Margin="0,3,0,0" />
                            <TextBlock Text="Gider" Foreground="#9AC2CC" FontSize="10" Margin="0,14,0,0" />
                            <TextBlock x:Name="TodayExpenseText" Text="0,00 TL" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0" />
                            <TextBlock Text="Net kâr" Foreground="#9AC2CC" FontSize="10" Margin="0,10,0,0" />
                            <TextBlock x:Name="TodayProfitText" Text="0,00 TL" Foreground="#A9E6C2" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0" />
                            <TextBlock Text="Başlangıç kasası" Foreground="#9AC2CC" FontSize="10" Margin="0,10,0,0" />
                            <TextBlock x:Name="OpeningCashSummaryText" Text="0,00 TL" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="30,22,30,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="SATIŞ NOKTASI" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                        <TextBlock Text="Kasa" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,2,0,0" />
                        <TextBlock Text="Ürün seçin, miktarı belirleyin ve satışı tamamlayın." Foreground="{StaticResource Muted}" FontSize="13" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button x:Name="AddProductTopButton" Grid.Column="1" Content="＋  Yeni ürün" Click="AddProductButton_Click" Style="{StaticResource RoundedButton}" Background="{StaticResource Accent}" Foreground="White" BorderThickness="0" Padding="17,11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <WrapPanel Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,14,0,0">
                    <Border Background="White" BorderBrush="#E2E8EC" BorderThickness="1" CornerRadius="9" Padding="11,0" Height="36" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Gün başlangıç kasası" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" />
                            <TextBox x:Name="OpeningCashBox" Text="0,00" Width="74" Height="30" Padding="7,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" BorderThickness="0" Background="Transparent" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="StartDayButton" Content="Günü başlat" Click="StartDayButton_Click" Style="{StaticResource RoundedButton}" Background="#EAF3F5" Foreground="{StaticResource Accent}" BorderBrush="#C9DDE2" Height="36" Padding="13,0" Margin="0,0,8,0" />
                    <Button x:Name="AddExpenseTopButton" Content="＋ Gider ekle" Click="AddExpenseButton_Click" Style="{StaticResource RoundedButton}" Background="#FFF5E8" Foreground="#C2410C" BorderBrush="#F5D6A4" Height="36" Padding="14,0" Margin="0,0,8,0" />
                    <Button x:Name="DayEndTopButton" Content="Gün sonu" Click="DayEndButton_Click" Style="{StaticResource RoundedButton}" Background="#FFFFFF" Foreground="{StaticResource Accent}" BorderBrush="#D4E1E5" Height="36" Padding="14,0" />
                </WrapPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="#E8EDF1" BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,0,18,0" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <StackPanel>
                                <TextBlock Text="Ürün kataloğu" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                                <TextBlock Text="Hızlı erişim ve barkodla ürün ekleme" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#F2F8FA" BorderBrush="#D5E9EE" BorderThickness="1" CornerRadius="12" Padding="10,5">
                                <TextBlock x:Name="ProductCountText" Text="0 ürün" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,16,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" BorderBrush="#D7E1E5" BorderThickness="1" CornerRadius="10" Padding="13,0" Background="#FAFCFD" Height="48">
                                <DockPanel>
                                    <Path Data="{StaticResource SearchIcon}" Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent" FontSize="14" VerticalContentAlignment="Center" Padding="0,10" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown" ToolTip="Ürün ara veya barkod okut" />
                                </DockPanel>
                            </Border>
                            <Button Grid.Column="1" Content="↥  Excel" Margin="12,0,0,0" Padding="15,0" Click="ImportExcelButton_Click" Style="{StaticResource RoundedButton}" Background="#EAF3F5" Foreground="{StaticResource Accent}" BorderBrush="#C9DDE2" />
                        </Grid>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ProductButtons" HorizontalContentAlignment="Stretch">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ProductButton}" Tag="{Binding}" Click="ProductButton_Click" Width="158" Height="116">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Ürünü düzenle" Click="EditProductMenuItem_Click" />
                                                    <MenuItem Header="Ürünü katalogdan sil" Click="DeleteProductMenuItem_Click" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <StackPanel>
                                                <Grid Margin="0,0,0,7">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" HorizontalAlignment="Stretch" Background="#EAF3F5" CornerRadius="5" Padding="5,3" MaxWidth="95">
                                                        <TextBlock Text="{Binding Category}" Foreground="{StaticResource Accent}" FontSize="9" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    </Border>
                                                    <Border Grid.Column="1" HorizontalAlignment="Right" Background="#F1F5F7" CornerRadius="5" Padding="5,3" Margin="4,0,0,0">
                                                        <TextBlock Foreground="{StaticResource Muted}" FontSize="9" FontWeight="SemiBold">
                                                            <Run Text="Stok " />
                                                            <Run Text="{Binding Stock, StringFormat={}{0:0.##}}" />
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxHeight="38" />
                                                <TextBlock Text="{Binding PriceText}" Foreground="#0D3B49" TextAlignment="Center" FontSize="15" FontWeight="Bold" Margin="0,6,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="#E8EDF1" BorderThickness="1" CornerRadius="16" Padding="22" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Alışveriş sepeti" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                                <TextBlock Text="Satışa hazır ürünler" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Content="Sepeti sıfırla" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ClearCartButton_Click" Background="Transparent" BorderThickness="0" Foreground="#C2413A" FontSize="11" Cursor="Hand" />
                        </Grid>
                        <DataGrid x:Name="CartGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserReorderColumns="False" IsReadOnly="True" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" Background="White" AlternationCount="2" AlternatingRowBackground="#FAFCFD" ColumnHeaderStyle="{StaticResource CartColumnHeader}" RowStyle="{StaticResource CartRow}" CellStyle="{StaticResource CartCell}" SelectionChanged="CartGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="ÜRÜN" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource Ink}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding UnitPrice, StringFormat={}{0:N2} TL / adet}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="ADET" Width="94">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Content="−" Tag="{Binding}" Click="DecreaseQuantityButton_Click" Width="25" Height="25" Background="White" BorderBrush="#DCE4E8" Foreground="{StaticResource Ink}" FontSize="14" FontWeight="SemiBold" Padding="0" />
                                                <TextBlock Text="{Binding Quantity}" Width="27" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                                                <Button Content="＋" Tag="{Binding}" Click="IncreaseQuantityButton_Click" Width="25" Height="25" Background="#EAF3F5" BorderBrush="#C9DDE2" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold" Padding="0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="TOPLAM" Binding="{Binding LineTotal, StringFormat={}{0:N2} TL}" Width="82" FontWeight="SemiBold" />
                                <DataGridTemplateColumn Header="" Width="38">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Tag="{Binding}" Click="RemoveCartItemButton_Click" Foreground="#DC2626" Background="Transparent" BorderThickness="0" Width="28" Height="28" ToolTip="Ürünü sepetten sil">
                                                <Path Data="{StaticResource TrashIcon}" Width="14" Height="14" Stretch="Uniform" Stroke="#DC2626" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Row="2" Background="#F7F9FA" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,16,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Seçili ürün adedi" Foreground="{StaticResource Muted}" FontSize="12" />
                                    <TextBlock x:Name="SelectedProductText" Text="Bir ürün seçin" Foreground="{StaticResource Ink}" FontWeight="SemiBold" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="−" Width="34" Height="34" Click="DecreaseQuantityButton_Click" Background="White" BorderBrush="#D0D5DD" />
                                    <TextBlock x:Name="QuantityText" Text="1" Width="34" TextAlignment="Center" VerticalAlignment="Center" FontSize="17" FontWeight="Bold" />
                                    <Button Content="＋" Width="34" Height="34" Click="IncreaseQuantityButton_Click" Background="{StaticResource AccentLight}" BorderBrush="#CBE4E9" Foreground="{StaticResource Accent}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="3">
                            <Border Background="{StaticResource BrandDeepBrush}" CornerRadius="13" Padding="16,14" Margin="0,0,0,14">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="GENEL TOPLAM" FontSize="10" FontWeight="Bold" Foreground="#B4D3D9" />
                                        <TextBlock Text="Ödeme tutarı" FontSize="11" Foreground="#D4E8EE" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <TextBlock x:Name="TotalText" Text="0,00 TL" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="27" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI Semibold" />
                                </Grid>
                            </Border>
                            <TextBlock Text="Ödeme yöntemi" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Tag="Nakit" Height="62" Click="PaymentButton_Click" Style="{StaticResource RoundedButton}" Background="#E9F8F1" Foreground="#047857" BorderBrush="#B7E7D1" Margin="0,0,4,0" Padding="2,4">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{StaticResource CashIcon}" Width="18" Height="15" Stretch="Uniform" Stroke="#10B981" StrokeThickness="1.5" StrokeLineJoin="Round" HorizontalAlignment="Center" />
                                        <TextBlock Text="Nakit" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0" />
                                        <TextBlock Text="F1" FontSize="9" Foreground="#488A70" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Tag="Kart" Height="62" Click="PaymentButton_Click" Style="{StaticResource RoundedButton}" Background="#EAF7FD" Foreground="#0369A1" BorderBrush="#B9E4F6" Margin="2,0" Padding="2,4">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{StaticResource CardIcon}" Width="18" Height="15" Stretch="Uniform" Stroke="#0EA5E9" StrokeThickness="1.5" StrokeLineJoin="Round" HorizontalAlignment="Center" />
                                        <TextBlock Text="Kart" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0" />
                                        <TextBlock Text="F2" FontSize="9" Foreground="#397E9D" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Tag="Veresiye" Height="62" Click="PaymentButton_Click" Style="{StaticResource RoundedButton}" Background="#FFF4EA" Foreground="#C2410C" BorderBrush="#FED7AA" Margin="2,0" Padding="2,4">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{StaticResource CreditIcon}" Width="18" Height="15" Stretch="Uniform" Stroke="#F97316" StrokeThickness="1.5" StrokeLineJoin="Round" HorizontalAlignment="Center" />
                                        <TextBlock Text="Veresiye" FontSize="10" FontWeight="SemiBold" Margin="0,3,0,0" />
                                        <TextBlock Text="F3" FontSize="9" Foreground="#A76537" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="3" Tag="Karma" Height="62" Click="PaymentButton_Click" Style="{StaticResource RoundedButton}" Background="#F1F4F7" Foreground="#344054" BorderBrush="#D5DDE4" Margin="4,0,0,0" Padding="2,4">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{StaticResource SplitIcon}" Width="18" Height="15" Stretch="Uniform" Stroke="#475467" StrokeThickness="1.5" StrokeLineJoin="Round" HorizontalAlignment="Center" />
                                        <TextBlock Text="Karma" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0" />
                                        <TextBlock Text="F4" FontSize="9" Foreground="#667085" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
    </Grid>
</Window>
