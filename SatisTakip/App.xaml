<Application x:Class="SatisTakip.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:local="clr-namespace:SatisTakip"
             ShutdownMode="OnExplicitShutdown"
             Startup="Application_Startup">
    <Application.Resources>
        <ResourceDictionary>
                    <SolidColorBrush x:Key="BrandDeepBrush" Color="#0D3B49" />
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F7F9" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AccentAmberBrush" Color="#F59E0B" />
                    <SolidColorBrush x:Key="SuccessGreenBrush" Color="#10B981" />
                    <SolidColorBrush x:Key="CardBlueBrush" Color="#0EA5E9" />
                    <SolidColorBrush x:Key="CreditOrangeBrush" Color="#F97316" />
                    <SolidColorBrush x:Key="InkBrush" Color="#172B3A" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#667085" />
                    <SolidColorBrush x:Key="BorderBrush" Color="#E4EAF0" />
                    <SolidColorBrush x:Key="BrandSoftBrush" Color="#EAF3F5" />
                    <DropShadowEffect x:Key="CardShadow" Color="#0D3B49" Opacity="0.06" BlurRadius="15" ShadowDepth="2" />
                    <shell:WindowChrome x:Key="ModernWindowChrome"
                                        CaptionHeight="44"
                                        ResizeBorderThickness="6"
                                        GlassFrameThickness="0"
                                        CornerRadius="0"
                                        UseAeroCaptionButtons="False" />

                    <Geometry x:Key="UserIcon">M12,12A4,4 0 1 0 12,4A4,4 0 0 0 12,12 M4,21C4,17.7 7.6,15 12,15C16.4,15 20,17.7 20,21</Geometry>
                    <Geometry x:Key="KeyIcon">M7.5,14A4.5,4.5 0 1 1 11.7,8H22V12H19V15H16V12H11.7A4.5,4.5 0 0 1 7.5,14 M7.5,11A1,1 0 1 0 7.5,9A1,1 0 0 0 7.5,11</Geometry>
                    <Geometry x:Key="CashIcon">M3,6H21V18H3Z M7,9A3,3 0 0 1 4,12 M17,9A3,3 0 0 0 20,12 M7,15A3,3 0 0 0 4,12 M17,15A3,3 0 0 1 20,12 M12,14A2,2 0 1 0 12,10A2,2 0 0 0 12,14</Geometry>
                    <Geometry x:Key="CardIcon">M3,5H21V19H3Z M3,9H21 M7,15H11</Geometry>
                    <Geometry x:Key="CreditIcon">M12,2A10,10 0 1 0 12,22A10,10 0 0 0 12,2 M8,12H16 M12,8V16</Geometry>
                    <Geometry x:Key="SplitIcon">M4,6H9A4,4 0 0 1 13,10V14A4,4 0 0 0 17,18H20 M16,14L20,18L16,22 M4,18H7A4,4 0 0 0 11,14V10A4,4 0 0 1 15,6H20 M16,2L20,6L16,10</Geometry>
                    <Geometry x:Key="MinimizeIcon">M5,12H19</Geometry>
                    <Geometry x:Key="MaximizeIcon">M5,5H19V19H5Z</Geometry>
                    <Geometry x:Key="CloseIcon">M6,6L18,18 M18,6L6,18</Geometry>
                    <Geometry x:Key="SearchIcon">M10.8,3A7.8,7.8 0 1 0 10.8,18.6A7.8,7.8 0 0 0 10.8,3 M16.5,16.5L22,22</Geometry>
                    <Geometry x:Key="TrashIcon">M4,7H20 M10,11V17 M14,11V17 M6,7L7,21H17L18,7 M9,7V4H15V7</Geometry>
                    <Geometry x:Key="ProductsMenuIcon">M4,4H10V10H4Z M14,4H20V10H14Z M4,14H10V20H4Z M14,14H20V20H14Z</Geometry>
                    <Geometry x:Key="StockMenuIcon">M12,3V11 M8,7H16 M4,12L12,8L20,12V20H4Z</Geometry>
                    <Geometry x:Key="WarningMenuIcon">M12,3L22,21H2Z M12,9V14 M12,18V18.1</Geometry>
                    <Geometry x:Key="MovementMenuIcon">M4,8H20 M16,4L20,8L16,12 M20,16H4 M8,12L4,16L8,20</Geometry>
                    <Geometry x:Key="ImportMenuIcon">M12,16V4 M7,9L12,4L17,9 M4,20H20</Geometry>
                    <Geometry x:Key="LedgerMenuIcon">M5,3H19V21H5Z M8,8H16 M8,12H16 M8,16H13</Geometry>
                    <Geometry x:Key="PeopleMenuIcon">M9,11A3.5,3.5 0 1 0 9,4A3.5,3.5 0 0 0 9,11 M3,20C3,16.7 5.7,14 9,14C12.3,14 15,16.7 15,20 M15,5A3.5,3.5 0 0 1 15,11 M16,14C18.9,14.4 21,16.8 21,20</Geometry>
                    <Geometry x:Key="ReceiptMenuIcon">M5,3H19V21L16,19L13,21L10,19L7,21L5,20Z M8,8H16 M8,12H16 M8,16H13</Geometry>
                    <Geometry x:Key="ChartMenuIcon">M4,20V12H8V20Z M10,20V7H14V20Z M16,20V3H20V20Z</Geometry>
                    <Geometry x:Key="CalendarMenuIcon">M4,5H20V21H4Z M8,3V7 M16,3V7 M4,10H20 M8,14H10 M14,14H16 M8,17H10</Geometry>
                    <Geometry x:Key="BackupMenuIcon">M12,3V15 M7,10L12,15L17,10 M4,20H20</Geometry>
                    <Geometry x:Key="RestoreMenuIcon">M12,15V3 M7,8L12,3L17,8 M4,20H20</Geometry>
                    <Geometry x:Key="SettingsMenuIcon">M12,3V5 M12,19V21 M3,12H5 M19,12H21 M5.6,5.6L7,7 M17,17L18.4,18.4 M18.4,5.6L17,7 M7,17L5.6,18.4 M16,12A4,4 0 1 0 8,12A4,4 0 0 0 16,12</Geometry>

                    <Style x:Key="WindowControlButton" TargetType="{x:Type Button}">
                        <Setter Property="Width" Value="44" />
                        <Setter Property="Height" Value="36" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border x:Name="ChromeButtonBorder" Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ChromeButtonBorder" Property="Background" Value="#254F5B" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="ChromeButtonBorder" Property="Background" Value="#356875" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style x:Key="LoginInputTextBox" TargetType="{x:Type TextBox}">
                        <Setter Property="Height" Value="48" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type TextBox}">
                                    <Border x:Name="InputBorder" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="10">
                                        <DockPanel Margin="13,0">
                                            <Path Data="{TemplateBinding Tag}" Width="17" Height="17" Margin="0,0,12,0" Stretch="Uniform" Stroke="#667085" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <EventTrigger RoutedEvent="GotFocus">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetName="InputBorder" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#0D3B49" Duration="0:0:0.16" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="LostFocus">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetName="InputBorder" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#D0D5DD" Duration="0:0:0.16" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style x:Key="LoginInputPasswordBox" TargetType="{x:Type PasswordBox}">
                        <Setter Property="Height" Value="48" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type PasswordBox}">
                                    <Border x:Name="InputBorder" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="10">
                                        <DockPanel Margin="13,0">
                                            <Path Data="{TemplateBinding Tag}" Width="17" Height="17" Margin="0,0,12,0" Stretch="Uniform" Stroke="#667085" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <EventTrigger RoutedEvent="GotFocus">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetName="InputBorder" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#0D3B49" Duration="0:0:0.16" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="LostFocus">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetName="InputBorder" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#D0D5DD" Duration="0:0:0.16" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style x:Key="LoginActionButton" TargetType="{x:Type Button}">
                        <Setter Property="Height" Value="48" />
                        <Setter Property="Background" Value="#0D3B49" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FontSize" Value="15" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border x:Name="LoginButtonBorder" Background="#0D3B49" CornerRadius="10" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="LoginButtonScale" />
                                        </Border.RenderTransform>
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualStateGroup.Transitions>
                                                    <VisualTransition GeneratedDuration="0:0:0.14" />
                                                </VisualStateGroup.Transitions>
                                                <VisualState x:Name="Normal">
                                                    <Storyboard>
                                                        <ColorAnimation Storyboard.TargetName="LoginButtonBorder" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#0D3B49" Duration="0:0:0.14" />
                                                        <DoubleAnimation Storyboard.TargetName="LoginButtonScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.14" />
                                                        <DoubleAnimation Storyboard.TargetName="LoginButtonScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.14" />
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState x:Name="MouseOver">
                                                    <Storyboard>
                                                        <ColorAnimation Storyboard.TargetName="LoginButtonBorder" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#145465" Duration="0:0:0.14" />
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState x:Name="Pressed">
                                                    <Storyboard>
                                                        <ColorAnimation Storyboard.TargetName="LoginButtonBorder" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#082F3A" Duration="0:0:0.08" />
                                                        <DoubleAnimation Storyboard.TargetName="LoginButtonScale" Storyboard.TargetProperty="ScaleX" To="0.98" Duration="0:0:0.08" />
                                                        <DoubleAnimation Storyboard.TargetName="LoginButtonScale" Storyboard.TargetProperty="ScaleY" To="0.98" Duration="0:0:0.08" />
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState x:Name="Disabled" />
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style TargetType="{x:Type ScrollBar}">
                        <Setter Property="Width" Value="7" />
                        <Setter Property="MinWidth" Value="7" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ScrollBar}">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Border Background="#C5D0D7" CornerRadius="4" Margin="1" />
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
